# AI workspace exclusions
# Ignore generated or noisy files that are not useful for code review or agent work.

node_modules/
.git/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.swp
*.bak
.DS_Store
Thumbs.db

# Local environment and generated config
.env
.env.*
*.local
.local/
coverage/
.dist/
build/
dist/
.cache/

# Large or non-source artifacts
*.min.js
*.map
*.zip
*.tar
*.gz

# Project-specific generated outputs
backend/.venv/
frontend/node_modules/
frontend/dist/
frontend/build/
